# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (Optional - for paid features)
# Get free MongoDB Atlas at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=

# Hugging Face API Configuration
# Get your free API key at: https://huggingface.co/settings/tokens
# Leave blank to run in demo mode without real image generation
HUGGING_FACE_API_KEY=

# Authentication (Required for paid features)
# SECURITY: Generate a strong random JWT secret using one of these methods:
# - Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# - OpenSSL: openssl rand -base64 32
# - Online: https://generate-secret.vercel.app/32 (use with caution)
# NEVER use the default value in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Stripe Payment Configuration (Optional - for paid features)
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_BASIC_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_PRICE_ID=

